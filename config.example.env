# Settings for the dev scripts (scripts/*.sh). Copy to config.env - it is git-ignored. No secrets belong here.
# The TV (rooted, SSH enabled in the Homebrew Channel settings)
TV_IP=192.168.1.50
TV_SSH_KEY=$HOME/.ssh/id_rsa
# optional: a separate known_hosts file for the TV
#TV_KNOWN_HOSTS=$HOME/.ssh/tv_known_hosts
# optional: this machine's address as the TV sees it (detected automatically) and the port to serve the package on
#PC_IP=192.168.1.10
#PC_HTTP_PORT=1759
# optional: ares-package from LG's webOS CLI (npm i -g @webos-tools/cli); defaults to the one on PATH
#ARES_PACKAGE=ares-package
# optional: a Jellyfin server the sign-in screen suggests in your own builds (nothing is baked in by default)
#JFNATIVE_SERVER=https://jellyfin.example.com
